# Anthropic API key — required for AI generation
ANTHROPIC_API_KEY=
# No route uses this anymore as of the cost refactor (every route now uses
# one of the per-route vars below) — left set only so it doesn't silently
# become an unrecognized env var for existing deployments. Safe to unset.
ANTHROPIC_MODEL=claude-opus-5
# Mock interviews are ~8 model calls per session, so they default to the
# cheaper claude-sonnet-5; override here (e.g. claude-opus-5)
INTERVIEW_MODEL=claude-sonnet-5

# Per-route AI cost tiers (cost refactor). Each is independently
# env-overridable; unset uses the default shown.
# generate-cv: full CV generation quality needs the strongest model.
MODEL_GENERATE=claude-opus-5
# suggest, polish, tailor, diagnose, and keyword-gap's per-user diff call:
# short-to-medium, mostly mechanical rewrites/matching — a mid-tier model at
# low-to-medium effort is plenty.
MODEL_LIGHT=claude-sonnet-5
# import-cv's AI extraction and keyword-gap's in-demand-skills extraction:
# cheap, mechanical work — route both to the cheapest model. Note:
# claude-haiku-4-5 does not support the effort/thinking parameters, so these
# routes send neither.
MODEL_EXTRACT=claude-haiku-4-5
# Hard monthly cap per licence key (or per IP in beta mode), on top of the
# hourly rate limit, to bound worst-case spend on generate-cv/suggest/polish/
# tailor/import-cv/diagnose/keyword-gap. Rolling 30-day window. Does NOT cover
# /api/interview, which is deliberately excluded and has its own, separate,
# much-higher-volume hourly + daily-session caps (interviewRateLimit /
# betaInterviewRateLimit / interviewDailyLimit in server.js) — a licence key
# using only /api/interview can reach several times this limit in a month and
# never trip it.
# Beta mode uses a lower built-in default (100/month/IP) — not env-overridable
# here; see server.js's betaMonthlyAiLimit option if you need to change it.
MONTHLY_AI_LIMIT=300

# Role keyword gap ("what this role really asks for") needs the JobPilot API
# for its live job-advert corpus. LEAVE UNSET to hide the feature entirely —
# CV Studio then runs fully standalone. Flip on once the API is production-
# hosted; no code change or redeploy needed beyond these env vars.
JOBPILOT_API_URL=
JOBPILOT_API_TOKEN=

# "false" (default) = AI features need a paid licence key; building/preview/
# export stay free. Set to "true" only for local testing, or when the JobPilot
# app's own billing fronts access instead of Lemon Squeezy.
BETA_MODE=false

# Lemon Squeezy (standalone deployments only; not used as a JobPilot plugin)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_CHECKOUT_URL=https://YOURSTORE.lemonsqueezy.com/buy/YOUR-PRODUCT-UUID
LEMONSQUEEZY_WEBHOOK_SECRET=

PORT=3000
